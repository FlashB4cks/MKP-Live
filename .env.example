# Django Core Settings
SECRET_KEY=change-me-in-production-random-secret-key-32-chars-long
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS settings (Front-end URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration
# Leave empty or unset for local SQLite development
# For Production / Cloud (e.g. Supabase, Render, Railway, Neon):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DATABASE_URL=

# Channels / Redis Layer
# In local development without Redis, leave empty to use in-memory channel layer
# For Production:
# REDIS_URL=redis://default:password@hostname:6379/0
REDIS_URL=

# Media Storage (Optional cloud storage like Cloudinary / AWS S3)
USE_S3=False
